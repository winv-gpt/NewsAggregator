# Only needed to run the bot on your own computer. Copy to .env and fill in. Never commit .env.
# (On GitHub the key comes from the ANTHROPIC_API_KEY repository secret instead.)

# Anthropic API key, from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Optional overrides
# NEWSBOT_MODEL=claude-sonnet-5   (or claude-opus-5 for sharper judgment, ~2.5x the cost)
# NEWSBOT_EFFORT=medium
