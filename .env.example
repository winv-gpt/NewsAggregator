# Copy this file to .env and fill in the values. Never commit .env.

# Anthropic API key, from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Telegram: create a bot with @BotFather to get the token, then send your bot
# any message and run `python setup_telegram.py` to find your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: public URL of the webpage, linked at the bottom of each Telegram message
NEWSBOT_PAGE_URL=

# Optional overrides
# NEWSBOT_MODEL=claude-sonnet-5   (or claude-opus-5 for sharper judgment, ~2.5x the cost)
# NEWSBOT_EFFORT=medium
